# ===== 原始资料与提取产物（含内部/版权材料，永不入库）=====
data/*
!data/.gitkeep
*.xlsx
*.xls
*.csv
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.epub
*.mdb
*.accdb

# OCR / 提取输出
ocr_out/
extracted/
full_text.txt
pages/

# ===== 成稿与工作区（含真实业务内容，另建私有仓库管理）=====
推文存档/
content/
drafts/
*_workspace/

# ===== 密钥与本地配置 =====
.env
.env.*
*.secret
*.key
*.pem
secrets/
.vscode/
.idea/

# ===== 系统/临时文件 =====
.DS_Store
Thumbs.db
~$*
*.tmp
*.bak
__pycache__/
*.pyc
